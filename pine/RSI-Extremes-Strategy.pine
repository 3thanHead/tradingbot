//@version=5
strategy("RSI Extremes Strategy", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.1)

//========================
// Inputs
//========================
rsiLength = input.int(14, "RSI Length", minval=1)
rsiOverbought = input.int(70, "RSI Overbought", minval=50, maxval=100)
rsiOversold = input.int(30, "RSI Oversold", minval=0, maxval=50)

useSL = input.bool(true, "Use Stop Loss", group="Risk Management")
slPct = input.float(2.0, "Stop Loss %", minval=0.1, step=0.1, group="Risk Management")
useTP = input.bool(true, "Use Take Profit", group="Risk Management")
tpPct = input.float(4.0, "Take Profit %", minval=0.1, step=0.1, group="Risk Management")

tradeDirection = input.string("Both", "Trade Direction", options=["Long Only", "Short Only", "Both"])

//========================
// Calculate RSI
//========================
rsi = ta.rsi(close, rsiLength)

//========================
// Entry/Exit Conditions
//========================
// Long when RSI crosses above oversold (bouncing from extreme low)
longEntry = ta.crossover(rsi, rsiOversold) and (tradeDirection == "Long Only" or tradeDirection == "Both")

// Long exit when RSI reaches overbought
longExit = ta.crossover(rsi, rsiOverbought)

// Short when RSI crosses below overbought (falling from extreme high)
shortEntry = ta.crossunder(rsi, rsiOverbought) and (tradeDirection == "Short Only" or tradeDirection == "Both")

// Short exit when RSI reaches oversold
shortExit = ta.crossunder(rsi, rsiOversold)

//========================
// Calculate SL/TP
//========================
longSL = useSL ? close * (1 - slPct / 100) : na
longTP = useTP ? close * (1 + tpPct / 100) : na
shortSL = useSL ? close * (1 + slPct / 100) : na
shortTP = useTP ? close * (1 - tpPct / 100) : na

//========================
// Execute Trades
//========================
if longEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    if useSL or useTP
        strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if longExit and strategy.position_size > 0
    strategy.close("Long")

if shortEntry and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    if useSL or useTP
        strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

if shortExit and strategy.position_size < 0
    strategy.close("Short")

//========================
// Plotting
//========================
plot(rsi, "RSI", color=color.blue, linewidth=2)
hline(rsiOverbought, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(rsiOversold, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)

plotshape(longEntry, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(longExit, "Long Exit", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(shortEntry, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(shortExit, "Short Exit", shape.triangleup, location.belowbar, color.green, size=size.small)

bgcolor(rsi > rsiOverbought ? color.new(color.red, 90) : rsi < rsiOversold ? color.new(color.green, 90) : na)
