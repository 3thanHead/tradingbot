//@version=5
strategy("Mean Reversion BB+RSI - Extreme Entries", shorttitle="MR BB RSI Extreme", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.1,
         slippage=2)

//========================
// Inputs
//========================
bb_length = input.int(20, "Bollinger Bands Length", minval=1, group="Bollinger Bands")
bb_mult = input.float(2.0, "Bollinger Bands StdDev", minval=0.1, step=0.1, group="Bollinger Bands")

rsi_length = input.int(14, "RSI Length", minval=1, group="RSI")
rsi_oversold = input.int(30, "RSI Oversold", minval=10, maxval=40, group="RSI")
rsi_overbought = input.int(70, "RSI Overbought", minval=60, maxval=90, group="RSI")

maFastLen = input.int(9, "Fast MA Length", minval=1, group="Moving Averages")
maSlowLen = input.int(21, "Slow MA Length", minval=1, group="Moving Averages")

use_stop_loss = input.bool(true, "Use Stop Loss", group="Risk Management")
stop_loss_percent = input.float(1.5, "Stop Loss %", minval=0.1, step=0.1, group="Risk Management")
use_take_profit = input.bool(true, "Use Take Profit", group="Risk Management")
take_profit_percent = input.float(3.0, "Take Profit %", minval=0.1, step=0.1, group="Risk Management")

tradeDirection = input.string("Both", "Trade Direction", options=["Long Only", "Short Only", "Both"])

alert_long_entry = input.string("LONG_ENTRY", "Long Entry Message", group="Alerts")
alert_short_entry = input.string("SHORT_ENTRY", "Short Entry Message", group="Alerts")
alert_long_exit = input.string("LONG_EXIT", "Long Exit Message", group="Alerts")
alert_short_exit = input.string("SHORT_EXIT", "Short Exit Message", group="Alerts")

//========================
// Calculate Indicators
//========================
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
rsi = ta.rsi(close, rsi_length)
maFast = ta.ema(close, maFastLen)
maSlow = ta.ema(close, maSlowLen)

//========================
// Entry/Exit Conditions
//========================
// Long: Price at lower BB AND RSI in oversold (extreme)
long_entry = close <= bb_lower and rsi < rsi_oversold and (tradeDirection == "Long Only" or tradeDirection == "Both")

// Long exit: Price reaches opposite BB OR Fast MA crosses below Slow MA (trend reversal)
long_exit = close >= bb_upper or ta.crossunder(maFast, maSlow)

// Short: Price at upper BB AND RSI in overbought (extreme)
short_entry = close >= bb_upper and rsi > rsi_overbought and (tradeDirection == "Short Only" or tradeDirection == "Both")

// Short exit: Price reaches opposite BB OR Fast MA crosses above Slow MA (trend reversal)
short_exit = close <= bb_lower or ta.crossover(maFast, maSlow)

//========================
// Execute Trades
//========================
if long_entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    if use_stop_loss or use_take_profit
        stop_price = use_stop_loss ? close * (1 - stop_loss_percent / 100) : na
        limit_price = use_take_profit ? close * (1 + take_profit_percent / 100) : na
        strategy.exit("Long Exit", "Long", stop=stop_price, limit=limit_price)

if short_entry and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    if use_stop_loss or use_take_profit
        stop_price = use_stop_loss ? close * (1 + stop_loss_percent / 100) : na
        limit_price = use_take_profit ? close * (1 - take_profit_percent / 100) : na
        strategy.exit("Short Exit", "Short", stop=stop_price, limit=limit_price)

if long_exit and strategy.position_size > 0
    strategy.close("Long")

if short_exit and strategy.position_size < 0
    strategy.close("Short")

//========================
// Alert Detection
//========================
buySignal = strategy.position_size > 0 and strategy.position_size[1] == 0
sellSignal = strategy.position_size < 0 and strategy.position_size[1] == 0
buyExit = strategy.position_size == 0 and strategy.position_size[1] > 0
sellExit = strategy.position_size == 0 and strategy.position_size[1] < 0

alertcondition(buySignal, "Long Entry", "{{alert_long_entry}}")
alertcondition(sellSignal, "Short Entry", "{{alert_short_entry}}")
alertcondition(buyExit, "Long Exit", "{{alert_long_exit}}")
alertcondition(sellExit, "Short Exit", "{{alert_short_exit}}")

//========================
// Plotting
//========================
plot(bb_upper, "BB Upper", color.red, 2)
plot(bb_middle, "BB Middle", color.gray, 1)
plot(bb_lower, "BB Lower", color.green, 2)

plot(maFast, "Fast MA", color.aqua, linewidth=2)
plot(maSlow, "Slow MA", color.orange, linewidth=2)

bgcolor(rsi > rsi_overbought ? color.new(color.red, 90) : rsi < rsi_oversold ? color.new(color.green, 90) : na)

plotshape(buySignal, "Buy", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, color.red, size=size.small)
