//@version=5
indicator("Mean Reversion BB+RSI - Signal Indicator", shorttitle="MR BB RSI Signals", overlay=true)

//========================
// Inputs
//========================
bb_length = input.int(20, "Bollinger Bands Length", minval=1, group="Bollinger Bands")
bb_mult = input.float(2.0, "Bollinger Bands StdDev", minval=0.1, step=0.1, group="Bollinger Bands")

rsi_length = input.int(14, "RSI Length", minval=1, group="RSI")
rsi_oversold = input.int(30, "RSI Oversold", minval=10, maxval=40, group="RSI")
rsi_overbought = input.int(70, "RSI Overbought", minval=60, maxval=90, group="RSI")

maFastLen = input.int(9, "Fast MA Length", minval=1, group="Moving Averages")
maSlowLen = input.int(21, "Slow MA Length", minval=1, group="Moving Averages")

showEntries = input.bool(true, "Show Entry Signals", group="Display")
showExits = input.bool(true, "Show Exit Signals", group="Display")
showMAs = input.bool(true, "Show Moving Averages", group="Display")

//========================
// Calculate Indicators
//========================
[bb_middle, bb_upper, bb_lower] = ta.bb(close, bb_length, bb_mult)
rsi = ta.rsi(close, rsi_length)
maFast = ta.ema(close, maFastLen)
maSlow = ta.ema(close, maSlowLen)

//========================
// Entry/Exit Signals
//========================
// Long signals
long_entry = close <= bb_lower and rsi < rsi_oversold
long_exit = close >= bb_upper or ta.crossunder(maFast, maSlow)

// Short signals
short_entry = close >= bb_upper and rsi > rsi_overbought
short_exit = close <= bb_lower or ta.crossover(maFast, maSlow)

//========================
// Alert Conditions
//========================
alertcondition(long_entry, "Long Entry Signal", "LONG_ENTRY")
alertcondition(short_entry, "Short Entry Signal", "SHORT_ENTRY")
alertcondition(long_exit, "Long Exit Signal", "LONG_EXIT")
alertcondition(short_exit, "Short Exit Signal", "SHORT_EXIT")

//========================
// Plotting
//========================
plot(bb_upper, "BB Upper", color.red, 2)
plot(bb_middle, "BB Middle", color.gray, 1)
plot(bb_lower, "BB Lower", color.green, 2)

plot(showMAs ? maFast : na, "Fast MA", color.aqua, linewidth=2)
plot(showMAs ? maSlow : na, "Slow MA", color.orange, linewidth=2)

bgcolor(rsi > rsi_overbought ? color.new(color.red, 90) : rsi < rsi_oversold ? color.new(color.green, 90) : na)

// Entry signals
plotshape(showEntries ? long_entry : na, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.normal, text="LONG")
plotshape(showEntries ? short_entry : na, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.normal, text="SHORT")

// Exit signals
plotshape(showExits ? long_exit : na, "Long Exit", shape.xcross, location.abovebar, color.orange, size=size.small, text="EXIT")
plotshape(showExits ? short_exit : na, "Short Exit", shape.xcross, location.belowbar, color.orange, size=size.small, text="EXIT")
