# OANDA API Credentials
OANDA_API_KEY=your-api-key-here
OANDA_ACCOUNT_ID=your-account-id-here

# ngrok Auth Token (get free token from https://dashboard.ngrok.com/signup)
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# ngrok Static Domain (OPTIONAL - keeps same URL every restart)
# Get a free static domain from: https://dashboard.ngrok.com/domains
# Example: your-app-name-12345.ngrok-free.app
# If not set, ngrok will generate a random URL each time
# NGROK_STATIC_DOMAIN=your-app-name-12345.ngrok-free.app

# Trading Configuration (choose ONE method - priority order shown)
# 
# METHOD 1: Margin Amount (RECOMMENDED - Uses your account leverage)
# Specify margin to use, OANDA calculates position size based on your leverage
# Example: With 50:1 leverage, $100 margin = ~$5000 position size
# MARGIN_AMOUNT=100
#
# METHOD 2: USD Notional Amount (calculates exact units from price)
# Specify dollar amount to trade, units auto-calculated based on current price
# Example: TRADE_USD_AMOUNT=1000 means each trade is $1000 USD worth
# TRADE_USD_AMOUNT=1000
#
# METHOD 3: Fixed Units (traditional - specify exact units)
# Number of units to trade per position (default: 100)
TRADE_UNITS=100
#
# Priority: If MARGIN_AMOUNT is set, it overrides all others
# If MARGIN_AMOUNT not set but TRADE_USD_AMOUNT is set, uses that
# If neither set, uses TRADE_UNITS
# If none set, defaults to TRADE_UNITS=100

# Optional: Change to production
# For live trading, update main.go: oandaBaseURL = "https://api-fxtrade.oanda.com"
