      "combination": "sequential",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/cross-oversell-30",
          "comment": "RSI crosses 30"
        },
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD crosses up - Entry confirmation"
        }
      ]
    }, 
    "exit": {
