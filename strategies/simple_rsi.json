      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/cross-overbuy-70",
          "comment": "RSI crosses 70"
        },
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD crosses down - Exit confirmation"
        }
      ]
    }
  },
