{
  "name": "momentum",
  "description": "Simple momentum strategy - MACD trend + RSI confirmation, exits on reversal or extreme",
  "long": {
    "entry": {
      "combination": "sequential",
      "conditions": [
        {
          "webhook": "/webhook/rsi/crossed-down",
          "comment": "RSI crosses 30 (confirms potential upward momentum)"
        },
        {
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD bullish crossover (momentum shift)"
        },
        {
          "webhook": "/webhook/rsi/cross-center",
          "comment": "RSI crosses 50 (confirms upward momentum)"
        }
      ]
    },
    "exit": {
      "combination": "sequential",
      "conditions": [
        {
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD bearish crossover (momentum reversal)"
        },
        {
          "webhook": "/webhook/rsi/crossed-center",
          "comment": "RSI crosses back down through 50 (confirms downward momentum)"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "sequential",
      "conditions": [
        {
          "webhook": "/webhook/rsi/crossed-up",
          "comment": "RSI crosses 70 (confirms downward momentum)"
        },
        {
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD bearish crossover (momentum shift)"
        },
        {
          "webhook": "/webhook/rsi/crossed-center",
          "comment": "RSI crosses 50 (confirms downward momentum)"
        }
      ]
    },
    "exit": {
      "combination": "sequential",
      "conditions": [
        {
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD bullish crossover (momentum reversal)"
        },
        {
          "webhook": "/webhook/rsi/cross-center",
          "comment": "RSI crosses back up through 50 (confirms upward momentum)"
        }
      ]
    }
  }
}
