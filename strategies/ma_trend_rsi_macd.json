{
  "name": "MA Trend + RSI 50 + MACD Strategy",
  "description": "Long entry requires ALL: MA1 crosses above MA2 (trigger), Price above MA2, RSI above 50, MACD crosses up (trigger). Exit on RSI crosses down overbuy. Short is opposite.",
  "long": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-above-ma2",
          "comment": "MA1 crosses above MA2 - triggers entry"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/price-above-ma2",
          "comment": "Price above MA2 (21 EMA)"
        },
        {
          "type": "condition",
          "webhook": "/webhook/rsi/above-50",
          "comment": "RSI is above 50"
        },
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD crosses above signal line - triggers entry"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/cross-down-overbuy",
          "comment": "RSI crosses down from overbought"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-below-ma2",
          "comment": "MA1 crosses below MA2 - exit signal"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-below-ma2",
          "comment": "MA1 crosses below MA2 - triggers entry"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/price-below-ma2",
          "comment": "Price below MA2 (21 EMA)"
        },
        {
          "type": "condition",
          "webhook": "/webhook/rsi/below-50",
          "comment": "RSI is below 50"
        },
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD crosses below signal line - triggers entry"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/cross-up-oversell",
          "comment": "RSI crosses up from oversold"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-above-ma2",
          "comment": "MA1 crosses above MA2 - exit signal"
        }
      ]
    }
  }
}
