{
  "name": "MA Ribbon (MA1>MA2>MA3) + RSI 50 Strategy",
  "description": "Entry: MA ribbon alignment (MA1>MA2>MA3) + RSI above 50. Exit: MA1 crosses down MA2. Uses 3-MA ribbon with RSI filter.",
  "long": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/above-50",
          "comment": "RSI above 50 - bullish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-above-ma2",
          "comment": "MA1 (low/fast) above MA2 (mid) - uptrend confirmation"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma2-above-ma3",
          "comment": "MA2 (mid) above MA3 (high/slow) - ribbon alignment"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-down-ma2",
          "comment": "MA1 crosses down MA2 - exit signal"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/below-50",
          "comment": "RSI below 50 - bearish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-below-ma2",
          "comment": "MA1 (low/fast) below MA2 (mid) - downtrend confirmation"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma2-below-ma3",
          "comment": "MA2 (mid) below MA3 (high/slow) - ribbon alignment"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-up-ma2",
          "comment": "MA1 crosses up MA2 - exit signal"
        }
      ]
    }
  }
}
