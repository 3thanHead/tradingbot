{
  "name": "MA Ribbon + RSI 50 Strategy (15min)",
  "description": "Entry: RSI 50 momentum + MA#1 crosses MA#2. Exit: Stochastic RSI crossing 50 OR MA#1 crosses back. Stop loss and take profit via OANDA orders.",
  "long": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/above-50",
          "comment": "RSI above 50 - bullish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-up-ma2",
          "comment": "MA#1 crosses above MA#2 - entry timing"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/cross-down-50",
          "comment": "Stochastic RSI crosses down 50 - momentum weakening, exit LONG"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-down-ma2",
          "comment": "MA#1 crosses back below MA#2 - trend reversal exit"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/below-50",
          "comment": "RSI below 50 - bearish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-down-ma2",
          "comment": "MA#1 crosses below MA#2 - entry timing"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/cross-up-50",
          "comment": "Stochastic RSI crosses up 50 - momentum weakening, exit SHORT"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-cross-up-ma2",
          "comment": "MA#1 crosses back above MA#2 - trend reversal exit"
        }
      ]
    }
  }
}
