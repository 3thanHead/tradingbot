{
  "name": "MACD + EMA 9/21 + RSI (5min)",
  "description": "Entry: MACD cross, EMA 9 cross 21, RSI above/below 50. Exit: MACD cross and Stochastic RSI cross 20/80.",
  "long": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD bullish cross - momentum trigger"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ema/9-cross-up-21",
          "comment": "EMA 9 crosses above EMA 21 - short-term trend"
        },
        {
          "type": "condition",
          "webhook": "/webhook/rsi/above-50",
          "comment": "RSI above 50 - bullish momentum"
        }
      ]
    },
    "exit": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD bearish cross - momentum reversal"
        },
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/cross-down-80",
          "comment": "Stochastic RSI crosses below 80 - overbought exit"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD bearish cross - momentum trigger"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ema/9-cross-down-21",
          "comment": "EMA 9 crosses below EMA 21 - short-term trend"
        },
        {
          "type": "condition",
          "webhook": "/webhook/rsi/below-50",
          "comment": "RSI below 50 - bearish momentum"
        }
      ]
    },
    "exit": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD bullish cross - momentum reversal"
        },
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/cross-up-20",
          "comment": "Stochastic RSI crosses above 20 - oversold exit"
        }
      ]
    }
  }
}
