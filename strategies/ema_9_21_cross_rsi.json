{
  "name": "MA Ribbon + RSI 50 Strategy (15min) - Internal Cross Detection",
  "description": "Entry: RSI 50 momentum + MA#1 crosses MA#2 (detected internally) + 200 EMA trend filter. Exit: Stochastic RSI overbought/oversold. Uses position tracking webhooks for maximum reliability.",
  "long": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/above-50",
          "comment": "RSI above 50 - bullish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-above-ma2",
          "comment": "MA#1 above MA#2 - cross detected internally for reliability"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/price-above-ma4",
          "comment": "Price above 200 EMA - trade with major trend"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/overbought",
          "comment": "Stochastic RSI overbought - take profit on LONG"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/rsi/below-50",
          "comment": "RSI below 50 - bearish momentum"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/ma1-below-ma2",
          "comment": "MA#1 below MA#2 - cross detected internally for reliability"
        },
        {
          "type": "condition",
          "webhook": "/webhook/ma/price-below-ma4",
          "comment": "Price below 200 EMA - trade with major trend"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "type": "condition",
          "webhook": "/webhook/stochastic-rsi/oversold",
          "comment": "Stochastic RSI oversold - take profit on SHORT"
        }
      ]
    }
  }
}
