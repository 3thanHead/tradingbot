{
  "name": "default",
  "description": "Original bot behavior - RSI extremes + MACD confirmation with multiple exit conditions",
  "entry": {
    "combination": "all_sequential",
    "steps": [
      {
        "webhook": "/webhook/rsi/crossed-down",
        "comment": "RSI crosses below 30 (oversold)"
      },
      {
        "webhook": "/webhook/macd/cross-up",
        "comment": "MACD line crosses above signal"
      }
    ]
  },
  "exit": {
    "combination": "any",
    "conditions": [
      {
        "webhook": "/webhook/rsi/crossed-center",
        "comment": "RSI crosses 50 (double-cross exit)"
      },
      {
        "webhook": "/webhook/macd/cross-down",
        "comment": "MACD reversal (bearish)"
      },
      {
        "webhook": "/webhook/macd/cross-up",
        "comment": "MACD reversal (bullish)"
      },
      {
        "webhook": "/webhook/rsi/crossed-up",
        "comment": "RSI extreme (overbought)"
      },
      {
        "webhook": "/webhook/rsi/crossed-down",
        "comment": "RSI extreme (oversold)"
      }
    ]
  }
}
