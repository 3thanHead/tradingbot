{
  "name": "default",
  "description": "MACD momentum + RSI confirmation - exits on opposite RSI extreme",
  "entry": {
    "combination": "all",
    "steps": [
      {
        "webhook": "/webhook/rsi/crossed-down",
        "comment": "RSI oversold (preparing for LONG)"
      },
      {
        "webhook": "/webhook/macd/cross-up",
        "comment": "MACD bullish crossover"
      }
    ]
  },
  "exit": {
    "combination": "any",
    "conditions": [
      {
        "webhook": "/webhook/rsi/crossed-up",
        "comment": "Exit LONG when RSI overbought (>70)"
      },
      {
        "webhook": "/webhook/rsi/crossed-down",
        "comment": "Exit SHORT when RSI oversold (<30)"
      }
    ]
  }
}
