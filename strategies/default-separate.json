{
  "name": "default-separate",
  "description": "Separate LONG and SHORT entry/exit configurations - more flexible trading logic",
  "long": {
    "entry": {
      "combination": "all",
      "steps": [
        {
          "webhook": "/webhook/macd/cross-up",
          "comment": "MACD bullish crossover"
        },
        {
          "webhook": "/webhook/rsi/crossed-down",
          "comment": "RSI oversold (30-50 recovery zone)"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "webhook": "/webhook/rsi/crossed-up",
          "comment": "Exit LONG when RSI overbought (>70)"
        }
      ]
    }
  },
  "short": {
    "entry": {
      "combination": "all",
      "steps": [
        {
          "webhook": "/webhook/macd/cross-down",
          "comment": "MACD bearish crossover"
        },
        {
          "webhook": "/webhook/rsi/crossed-up",
          "comment": "RSI overbought (50-70 decline zone)"
        }
      ]
    },
    "exit": {
      "combination": "any",
      "conditions": [
        {
          "webhook": "/webhook/rsi/crossed-down",
          "comment": "Exit SHORT when RSI oversold (<30)"
        }
      ]
    }
  }
}
